# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Slideshow Settings
# Duration in seconds to display each photo on the TV screen
SLIDESHOW_DISPLAY_DURATION=8
# Enable or disable automatic ambient loop when no live uploads are in queue
AMBIENT_LOOP_ENABLED=True

# Upload & Validation Constraints
# Maximum file upload size in megabytes per photo (default 10MB)
MAX_UPLOAD_SIZE_MB=10
# Maximum number of photos a visitor can upload in a single submission
MAX_FILES_PER_UPLOAD=5
# Allowed image file extensions
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Privacy & Retention
# Require explicit consent to show on public slideshow (True/False)
REQUIRE_CONSENT=True
# Retention period in hours before photos are archived/hidden (0 = indefinite)
PHOTO_RETENTION_HOURS=24
